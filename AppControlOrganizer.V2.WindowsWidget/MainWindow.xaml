<Window
  x:Class="AppControlOrganizer.V2.WindowsWidget.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Widget AppLifePlanner"
  Width="360"
  Height="520"
  MinWidth="320"
  MinHeight="320"
  AllowsTransparency="False"
  Background="Transparent"
  ResizeMode="CanResizeWithGrip"
  ShowInTaskbar="True"
  TextOptions.TextFormattingMode="Display"
  TextOptions.TextRenderingMode="ClearType"
  Topmost="True"
  WindowStartupLocation="CenterScreen"
  WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome
      CaptionHeight="0"
      CornerRadius="0"
      GlassFrameThickness="0"
      ResizeBorderThickness="8"
      UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <DropShadowEffect
      x:Key="WidgetShadow"
      BlurRadius="42"
      Direction="270"
      Opacity="0.22"
      ShadowDepth="18"
      Color="#0F172A" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="GlassSurfaceLightBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeSoftBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="GlassControlBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#94A3B8" />
    <LinearGradientBrush x:Key="AccentLineBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#38BDF8" />
      <GradientStop Offset="0.48" Color="#22D3EE" />
      <GradientStop Offset="1" Color="#5EEAD4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroGlassBrush" Color="#08FFFFFF" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="Typography.NumeralStyle" Value="Lining" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{StaticResource GlassControlBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="12">
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource GlassSurfaceLightBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="16"
              Padding="{TemplateBinding Padding}">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="NumericMetricStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
      x:Key="CollapseWhenEmptyTextStyle"
      BasedOn="{StaticResource {x:Type TextBlock}}"
      TargetType="TextBlock">
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardResizeGripStyle" TargetType="primitives:Thumb">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Cursor" Value="SizeNWSE" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Panel.ZIndex" Value="100" />
      <EventSetter Event="DragStarted" Handler="OnCardResizeDragStarted" />
      <EventSetter Event="DragDelta" Handler="OnCardResizeDragDelta" />
      <EventSetter Event="DragCompleted" Handler="OnCardResizeDragCompleted" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="primitives:Thumb">
            <Border Background="#01FFFFFF" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border
    Background="{StaticResource GlassSurfaceBrush}"
    BorderBrush="{StaticResource GlassStrokeBrush}"
    BorderThickness="1"
    CornerRadius="22"
    Effect="{StaticResource WidgetShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border
        x:Name="TitleBar"
        Grid.Row="0"
        Background="{StaticResource GlassSurfaceBrush}"
        CornerRadius="22,22,0,0"
        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
        Padding="12,8,10,4">
        <DockPanel LastChildFill="True">
          <StackPanel
            DockPanel.Dock="Right"
            Orientation="Horizontal">
            <Button
              x:Name="SoundToggleButton"
              Click="OnSoundToggleClick"
              Content="&#xE767;"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Style="{StaticResource IconButtonStyle}"
              ToolTip="Configurar alerta sonoro" />
            <primitives:Popup
              x:Name="SoundSettingsPopup"
              AllowsTransparency="True"
              Placement="Bottom"
              PlacementTarget="{Binding ElementName=SoundToggleButton}"
              StaysOpen="False">
              <Border
                Width="236"
                Margin="0,8,0,0"
                Padding="12"
                Background="#F20F172A"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                  <CheckBox
                    x:Name="ActivitySoundEnabledCheckBox"
                    Margin="0,0,0,10"
                    Checked="OnActivitySoundEnabledChanged"
                    Content="Alertas sonoros"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Unchecked="OnActivitySoundEnabledChanged" />
                  <TextBlock
                    Margin="0,0,0,4"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SubtleTextBrush}"
                    Text="Som" />
                  <ComboBox
                    x:Name="ActivitySoundKindComboBox"
                    Margin="0,0,0,10"
                    Padding="6,4"
                    SelectionChanged="OnActivitySoundKindChanged" />
                  <TextBlock
                    x:Name="ActivitySoundVolumeText"
                    Margin="0,0,0,4"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SubtleTextBrush}"
                    Text="Volume 70%" />
                  <Slider
                    x:Name="ActivitySoundVolumeSlider"
                    IsSnapToTickEnabled="True"
                    LostMouseCapture="OnActivitySoundVolumeCommit"
                    LostKeyboardFocus="OnActivitySoundVolumeCommit"
                    Maximum="100"
                    Minimum="0"
                    PreviewKeyUp="OnActivitySoundVolumeKeyUp"
                    PreviewMouseLeftButtonUp="OnActivitySoundVolumeCommit"
                    TickFrequency="5"
                    ValueChanged="OnActivitySoundVolumeChanged" />
                </StackPanel>
              </Border>
            </primitives:Popup>
            <Button
              x:Name="SaveLayoutButton"
              Margin="6,0,0,0"
              Click="OnSaveLayoutClick"
              Content="&#xE74E;"
              IsEnabled="False"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Style="{StaticResource IconButtonStyle}"
              ToolTip="Salvar layout" />
            <Button
              x:Name="RestoreLayoutButton"
              Margin="6,0,0,0"
              Click="OnRestoreLayoutClick"
              Content="&#xE777;"
              IsEnabled="False"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Style="{StaticResource IconButtonStyle}"
              ToolTip="Restaurar layout salvo" />
            <Button
              x:Name="RefreshButton"
              Margin="6,0,0,0"
              Click="OnRefreshClick"
              Content="&#xE72C;"
              RenderTransformOrigin="0.5,0.5"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Style="{StaticResource IconButtonStyle}"
              ToolTip="Atualizar">
              <Button.RenderTransform>
                <RotateTransform x:Name="RefreshButtonRotation" Angle="0" />
              </Button.RenderTransform>
            </Button>
            <Button
              x:Name="MinimizeButton"
              Margin="6,0,0,0"
              Click="OnMinimizeClick"
              Content="&#xE921;"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Style="{StaticResource IconButtonStyle}"
              ToolTip="Minimizar" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border
              x:Name="HeaderIconBadge"
              Width="30"
              Height="30"
              Background="{StaticResource GlassControlBrush}"
              BorderBrush="{StaticResource GlassStrokeBrush}"
              BorderThickness="1"
              CornerRadius="12">
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="13"
                Foreground="#2DD4BF"
                Text="&#xE9D2;" />
            </Border>
            <StackPanel Margin="10,0,0,0">
              <TextBlock
                x:Name="AppLabelText"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="{StaticResource SubtleTextBrush}"
                Text="APPLIFEPLANNER" />
              <TextBlock
                x:Name="HeaderText"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="Hoje" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid
          x:Name="PairingPanel"
          Margin="16,8,16,16">
          <Border
            Background="{StaticResource GlassSurfaceBrush}"
            BorderBrush="{StaticResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock
                x:Name="PairingTitleText"
                Grid.Row="0"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="Parear widget" />
              <TextBlock
                x:Name="PairingDescriptionText"
                Grid.Row="1"
                Margin="0,6,0,16"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="Cole o código do Perfil e o token GitHub uma vez."
                TextWrapping="Wrap" />
              <TextBox
                x:Name="BaseUrlTextBox"
                Grid.Row="2"
                Margin="0,0,0,8"
                Padding="10,8"
                Text="https://applifeplanner.onrender.com"
                ToolTip="URL do AppLifePlanner" />
              <TextBox
                x:Name="PairingCodeTextBox"
                Grid.Row="3"
                Margin="0,0,0,8"
                Padding="10,8"
                CharacterCasing="Upper"
                ToolTip="Código" />
              <PasswordBox
                x:Name="GitHubTokenBox"
                Grid.Row="4"
                Margin="0,0,0,14"
                Padding="10,8"
                ToolTip="Token GitHub para atualizações automáticas" />
              <StackPanel Grid.Row="5">
                <Button
                  x:Name="PairButton"
                  Padding="14,10"
                  Background="{StaticResource GlassControlBrush}"
                  BorderBrush="{StaticResource GlassStrokeBrush}"
                  BorderThickness="1"
                  Click="OnPairClick"
                  Content="Parear"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Style="{StaticResource CardButtonStyle}" />
                <TextBlock
                  x:Name="PairingStatusText"
                  Margin="0,10,0,0"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

          <Grid
            x:Name="SnapshotPanel"
            ClipToBounds="False"
            Margin="14,4,14,14"
            Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Canvas
            x:Name="MovableCardsCanvas"
            Grid.RowSpan="3"
            ClipToBounds="False"
            IsHitTestVisible="True" />

          <Border
            x:Name="HeroCard"
            Grid.Row="0"
            Background="{StaticResource HeroGlassBrush}"
            BorderBrush="{StaticResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="0">
            <Grid ClipToBounds="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="74" />
              </Grid.ColumnDefinitions>
              <Grid
                x:Name="HeroMediaLayer"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                IsHitTestVisible="False">
                <Image
                  x:Name="HeroContextImage"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Opacity="0.58"
                  Stretch="UniformToFill">
                  <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Offset="0" Color="#22000000" />
                      <GradientStop Offset="0.38" Color="#88000000" />
                      <GradientStop Offset="1" Color="#FF000000" />
                    </LinearGradientBrush>
                  </Image.OpacityMask>
                </Image>
                <Border
                  x:Name="HeroImageOverlay"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="#30000000"
                  Visibility="Collapsed">
                  <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Offset="0" Color="#00000000" />
                      <GradientStop Offset="0.28" Color="#55000000" />
                      <GradientStop Offset="1" Color="#FF000000" />
                    </LinearGradientBrush>
                  </Border.OpacityMask>
                </Border>
              </Grid>
              <StackPanel Margin="12">
                <TextBlock
                  x:Name="StatusText"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="Hoje em movimento"
                  TextTrimming="CharacterEllipsis" />
                <Border
                  x:Name="ActivityChangedBadge"
                  HorizontalAlignment="Left"
                  Margin="0,7,0,0"
                  Padding="8,4"
                  Background="{StaticResource GlassControlBrush}"
                  BorderBrush="{StaticResource GlassStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Opacity="0"
                  Visibility="Collapsed">
                  <TextBlock
                    x:Name="ActivityChangedText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#2DD4BF"
                    Text="Agora" />
                </Border>
                <TextBlock
                  x:Name="CurrentTitleText"
                  Margin="0,3,0,0"
                  FontSize="27"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Carregando"
                  TextWrapping="Wrap" />
                <TextBlock
                  x:Name="CurrentDetailText"
                  Margin="0,2,0,0"
                  FontSize="14"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Text="Conectando..."
                  TextWrapping="Wrap" />
                <Grid
                  x:Name="CurrentProgressGrid"
                  Height="8"
                  Margin="0,10,0,0"
                  Visibility="Collapsed">
                  <Border
                    x:Name="CurrentProgressTrack"
                    Height="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource GlassStrokeBrush}"
                    CornerRadius="1" />
                  <Border
                    x:Name="CurrentProgressFill"
                    Width="0"
                    Height="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentLineBrush}"
                    CornerRadius="1" />
                </Grid>
                <UniformGrid
                  x:Name="HeroMetricsGrid"
                  Margin="0,8,0,0"
                  Columns="3">
                  <StackPanel>
                    <TextBlock
                      Style="{StaticResource MetricLabelStyle}"
                      Text="HOJE" />
                    <TextBlock
                      x:Name="TodayCountText"
                      Style="{StaticResource NumericMetricStyle}"
                      Text="0/0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock
                      Style="{StaticResource MetricLabelStyle}"
                      Text="RESTANTE" />
                    <TextBlock
                      x:Name="RemainingText"
                      Style="{StaticResource NumericMetricStyle}"
                      Text="-" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock
                      Style="{StaticResource MetricLabelStyle}"
                      Text="RITMO" />
                    <TextBlock
                      x:Name="SimilarCountText"
                      Style="{StaticResource NumericMetricStyle}"
                      Text="0x" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
              <Grid
                x:Name="ProgressRingPanel"
                Grid.Column="1"
                Width="64"
                Height="64"
                HorizontalAlignment="Right"
                Margin="0,12,12,12"
                RenderTransformOrigin="0.5,0.5"
                VerticalAlignment="Center">
                <Grid.RenderTransform>
                  <ScaleTransform
                    ScaleX="1"
                    ScaleY="1" />
                </Grid.RenderTransform>
                <Ellipse
                  Stroke="#14FFFFFF"
                  StrokeThickness="1.4" />
                <Ellipse
                  x:Name="ProgressPulseFill"
                  Margin="8"
                  Fill="#2DD4BF"
                  Opacity="0" />
                <Path
                  x:Name="ProgressRingArc"
                  Stroke="{StaticResource AccentLineBrush}"
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="2" />
                <StackPanel
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                  <TextBlock
                    x:Name="CurrentIconText"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="19"
                    Foreground="#2DD4BF"
                    Text="&#xE9D2;" />
                  <TextBlock
                    x:Name="ProgressPercentText"
                    HorizontalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="0%" />
                </StackPanel>
              </Grid>
              <primitives:Thumb
                Grid.ColumnSpan="2"
                Style="{StaticResource CardResizeGripStyle}"
                Tag="moments" />
            </Grid>
          </Border>

          <Grid
            x:Name="AdaptiveCardsGrid"
            Grid.Row="1"
            ClipToBounds="False"
            Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="PrimaryCardsColumn" Width="*" />
              <ColumnDefinition x:Name="SecondaryCardsColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
              x:Name="NextButton"
              Grid.Row="0"
              Grid.Column="0"
              Background="{StaticResource GlassSurfaceLightBrush}"
              BorderBrush="{StaticResource GlassStrokeBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="9,7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                  Grid.Column="0"
                  Width="27"
                  Height="27"
                  Margin="0,0,9,0"
                  Background="{StaticResource GlassControlBrush}"
                  BorderBrush="{StaticResource GlassStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
                  <TextBlock
                    x:Name="NextIconText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="13"
                    Foreground="#F59E0B"
                    Text="&#xE8AD;" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#F59E0B"
                    Text="PRÓXIMO" />
                  <TextBlock
                    x:Name="NextTitleText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    x:Name="NextDetailText"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <primitives:Thumb
                  Grid.ColumnSpan="2"
                  Style="{StaticResource CardResizeGripStyle}"
                  Tag="next" />
              </Grid>
            </Border>

            <Border
              x:Name="TimelineCard"
              Grid.Row="1"
              Grid.Column="0"
              Margin="0,6,0,0"
              Background="{StaticResource GlassSurfaceLightBrush}"
              BorderBrush="{StaticResource GlassStrokeBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="8">
              <Grid>
                <StackPanel>
                  <TextBlock
                    x:Name="TimelineTitleText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="Próximos blocos" />
                  <ItemsControl
                    x:Name="TimelineItemsControl"
                    Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border
                          Width="{Binding Width}"
                          MinHeight="{Binding Height}"
                          Margin="0,0,6,6"
                          Background="{StaticResource GlassControlBrush}"
                          BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,7">
                          <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                              Grid.Column="0"
                              Width="36"
                              Height="36"
                              Margin="0,0,9,0"
                              Background="#14000000"
                              BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                              BorderThickness="1"
                              CornerRadius="9">
                              <Grid ClipToBounds="True">
                                <Image
                                  Opacity="0.42"
                                  Source="images/routine-thumb.webp"
                                  Stretch="UniformToFill" />
                                <Border Background="#99000000" />
                                <TextBlock
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="#60A5FA"
                                  Text="{Binding Icon}" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1">
                              <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                FontSize="11.5"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{Binding Detail}"
                                TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource SubtleTextBrush}"
                                Style="{StaticResource CollapseWhenEmptyTextStyle}"
                                Text="{Binding Extra}"
                                TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                              Grid.Column="2"
                              Margin="5,0,0,0"
                              FontFamily="Cascadia Mono, Consolas"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Foreground="#60A5FA"
                              Text="{Binding Time}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <primitives:Thumb
                  Style="{StaticResource CardResizeGripStyle}"
                  Tag="timeline" />
              </Grid>
            </Border>

            <Grid
              x:Name="SideCardsPanel"
              Grid.Row="2"
              Grid.Column="0"
              Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FocusActionsPrimaryColumn" Width="*" />
                <ColumnDefinition x:Name="FocusActionsSecondaryColumn" Width="0" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border
                x:Name="FocusCard"
                Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource GlassSurfaceLightBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="7">
                <Grid>
                  <StackPanel>
                    <TextBlock
                      x:Name="FocusTitleText"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      Text="Focos" />
                    <ItemsControl
                      x:Name="FocusItemsControl"
                      Margin="0,5,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                            MinWidth="86"
                            MinHeight="25"
                            Margin="0,0,4,4"
                            Background="{StaticResource GlassControlBrush}"
                            BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6,4"
                            ToolTip="{Binding FullText}">
                            <StackPanel Orientation="Horizontal">
                              <Border
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                Background="#102DD4BF"
                                BorderBrush="#2434D399"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="9"
                                  Foreground="#2DD4BF"
                                  Text="&#xE9F5;" />
                              </Border>
                              <TextBlock
                                Margin="0,0,4,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="#2DD4BF"
                                Text="&#xE73E;" />
                              <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding Text}"
                                TextTrimming="CharacterEllipsis"
                                Width="{Binding Width}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <primitives:Thumb
                    Style="{StaticResource CardResizeGripStyle}"
                    Tag="focus" />
                </Grid>
              </Border>

              <Border
                x:Name="ActionsCard"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,5,0,0"
                Background="{StaticResource GlassSurfaceLightBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="7">
                <Grid>
                  <StackPanel>
                    <TextBlock
                      x:Name="ActionsTitleText"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      Text="Ações" />
                    <ItemsControl
                      x:Name="ActionItemsControl"
                      Margin="0,5,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid
                            Margin="0,0,0,5"
                            ToolTip="{Binding Detail}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                              Grid.Column="0"
                              Width="2"
                              Margin="0,0,7,0"
                              Background="#33FB923C"
                              CornerRadius="1" />
                            <TextBlock
                              Grid.Column="1"
                              Margin="0,1,8,0"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="10"
                              Foreground="#FB923C"
                              Text="&#xE945;" />
                            <StackPanel Grid.Column="2">
                              <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding FullTitle}" />
                              <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Style="{StaticResource CollapseWhenEmptyTextStyle}"
                                Text="{Binding Detail}"
                                TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource SubtleTextBrush}"
                                Style="{StaticResource CollapseWhenEmptyTextStyle}"
                                Text="{Binding Evidence}"
                                TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <primitives:Thumb
                    Style="{StaticResource CardResizeGripStyle}"
                    Tag="actions" />
                </Grid>
              </Border>
            </Grid>

            <Grid
              x:Name="InsightDeckPanel"
              Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="0,8,0,0"
              Visibility="Collapsed">
              <StackPanel>
                <TextBlock
                  x:Name="InsightDeckTitleText"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  Text="Painel rápido" />
                <ItemsControl
                  x:Name="InsightItemsControl"
                  Margin="0,6,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Margin="0,0,7,7"
                        Background="{Binding Background}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8"
                        ToolTip="{Binding Tooltip}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            Background="{Binding IconBackground}"
                            BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="13"
                              Foreground="{Binding Foreground}"
                              Text="{Binding Icon}" />
                          </Border>
                          <StackPanel
                            Grid.Column="1"
                            Margin="8,0,0,0">
                            <TextBlock
                              FontSize="10"
                              FontWeight="SemiBold"
                              Foreground="{Binding MutedForeground}"
                              Text="{Binding Title}"
                              TextTrimming="CharacterEllipsis" />
                            <TextBlock
                              FontFamily="Cascadia Mono, Consolas"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              Text="{Binding Value}"
                              TextTrimming="CharacterEllipsis" />
                            <TextBlock
                              FontSize="10"
                              Foreground="{Binding MutedForeground}"
                              Text="{Binding Detail}"
                              TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <primitives:Thumb
                Style="{StaticResource CardResizeGripStyle}"
                Tag="insights" />
            </Grid>
          </Grid>

          <Grid
            Grid.Row="2"
            Margin="2,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="FooterText"
              Grid.Column="0"
              VerticalAlignment="Center"
              FontSize="11"
              Foreground="{StaticResource SecondaryTextBrush}"
              Text="Atualizando..."
              TextAlignment="Left"
              Visibility="Collapsed" />
            <Button
              x:Name="UpdateStatusButton"
              Grid.Column="1"
              MinHeight="24"
              Padding="8,4"
              Background="{StaticResource GlassControlBrush}"
              BorderBrush="{StaticResource GlassStrokeSoftBrush}"
              BorderThickness="1"
              Click="OnConfigureUpdatesClick"
              Foreground="{StaticResource SecondaryTextBrush}"
              Style="{StaticResource CardButtonStyle}"
              ToolTip="Configurar atualizações automáticas"
              Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  Margin="0,0,6,0"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="10"
                  Text="&#xE895;" />
                <TextBlock
                  x:Name="UpdateStatusText"
                  FontSize="11"
                  Text="Atualizações desativadas" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
