@using Microsoft.JSInterop
@rendermode InteractiveServer
@inject AppControlOrganizer.V2.Web.Services.UI.ValuesVisibilityService ValuesVis
@inject IJSRuntime JS

<button class="btn btn-link text-white p-0 d-flex align-items-center text-decoration-none"
        title="@Loc["Show/hide values"]"
        @onclick="Toggle">
    <i class="@(ValuesVis.IsVisible ? "bi bi-eye" : "bi bi-eye-slash") fs-5 opacity-75"></i>
</button>

@code {
    private const string StorageKey = "valuesVisible";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            string? stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            bool saved = stored == "true";
            ValuesVis.SetVisible(saved);
            StateHasChanged();
        }
        catch { }
    }

    private async Task Toggle()
    {
        ValuesVis.Toggle();
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, ValuesVis.IsVisible ? "true" : "false");
        }
        catch { }
    }
}
