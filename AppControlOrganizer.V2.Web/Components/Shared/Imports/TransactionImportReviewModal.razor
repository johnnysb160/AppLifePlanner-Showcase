@*
    TransactionImportReviewModal.razor - Modal for reviewing and accepting/rejecting pending import items.
    Note: Inline editing selects (Category/Income) kept as simple form-select for performance reasons.
    Each row can have edit mode, and using SearchableDropdown would add overhead for all rows.
*@

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle me-2 text-warning"></i>@Loc["Review Pending Items"] (@PendingItems.Count)
                    </h5>
                    <button type="button" class="btn-close" @onclick="OnClose" disabled="@IsProcessing"></button>
                </div>
                <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                    @if (PendingItems.Count == 0)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>@Loc["No pending items to review."]
                        </div>
                    }
                    else
                    {
                        <!-- Bulk Actions -->
                        <div class="d-flex gap-2 mb-3 flex-wrap">
                            <button class="btn btn-sm btn-outline-primary" @onclick="SelectAll" disabled="@IsProcessing">
                                <i class="bi bi-check-all me-1"></i>@Loc["Select All"]
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAll" disabled="@IsProcessing">
                                <i class="bi bi-x-lg me-1"></i>@Loc["Deselect All"]
                            </button>
                            <button class="btn btn-sm btn-success" @onclick="AcceptAll" disabled="@IsProcessing">
                                <i class="bi bi-check-circle me-1"></i>@Loc["Accept All"]
                            </button>
                            <button class="btn btn-sm btn-success" @onclick="AcceptSelected" disabled="@(!HasSelection || IsProcessing)">
                                <i class="bi bi-check me-1"></i>@Loc["Accept Selected"] (@SelectedCount)
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="RejectSelected" disabled="@(!HasSelection || IsProcessing)">
                                <i class="bi bi-trash me-1"></i>@Loc["Reject Selected"]
                            </button>
                        </div>

                        <!-- Items Table -->
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;">
                                            <input type="checkbox" class="form-check-input"
                                                   @bind="SelectAllChecked"
                                                   @bind:after="OnSelectAllChanged"
                                                   disabled="@IsProcessing" />
                                        </th>
                                        <th style="width: 110px;">@Loc["Date"]</th>
                                        <th style="width: 150px;">@Loc["Category"]</th>
                                        <th>@Loc["Description"]</th>
                                        <th style="width: 100px;">@Loc["Amount"]</th>
                                        <th style="width: 90px;">@Loc["Type"]</th>
                                        <th style="width: 180px;">@Loc["Reason"]</th>
                                        <th style="width: 120px;">@Loc["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (PendingItem item in PendingItems)
                                    {
                                        <tr class="@(item.IsSelected ? "table-active" : "")">
                                            <td>
                                                <input type="checkbox" class="form-check-input" 
                                                       @bind="item.IsSelected" 
                                                       disabled="@IsProcessing" />
                                            </td>
                                            <td>
                                                @if (item.IsEditing)
                                                {
                                                    <input type="date" class="form-control form-control-sm" @bind="item.Date" />
                                                }
                                                else
                                                {
                                                    @item.Date.ToString("d", Loc.Culture)
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsEditing)
                                                {
                                                    <select class="form-select form-select-sm" @bind="item.Category">
                                                        @foreach (Category cat in Enum.GetValues<Category>())
                                                        {
                                                            <option value="@cat">@Loc[cat.GetDisplayName()]</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <a class="badge bg-secondary text-decoration-none" href="@($"transactions?category={item.Category}")">
                                                        @Loc[item.Category.GetDisplayName()]
                                                    </a>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsEditing)
                                                {
                                                    <input type="text" class="form-control form-control-sm" @bind="item.Description" />
                                                }
                                                else
                                                {
                                                    <span title="@item.Description">@TruncateText(item.Description, 50)</span>
                                                    <div class="pending-context-row">
                                                        @if (GetAccount(item.AccountId) is AccountEntity account)
                                                        {
                                                            <a href="@GetAccountHref(account.Id)">
                                                                <img src="@Helper.GetLogoDataUriOrDefault(account.Logo)" alt="" />
                                                                @account.Name
                                                            </a>
                                                        }
                                                        @if (GetCreditCard(item.CreditCardId) is CreditCardEntity card)
                                                        {
                                                            <a href="@GetAccountHref(card.AccountId)">
                                                                <i class="bi bi-credit-card"></i>
                                                                @card.HolderName
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsEditing)
                                                {
                                                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="item.Value" />
                                                }
                                                else
                                                {
                                                    @if (item.Currency == AppControlOrganizer.V2.Shared.Enums.Currency.USD)
                                                    {
                                                        @item.Value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                                    }
                                                    else
                                                    {
                                                        @item.Value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsEditing)
                                                {
                                                    <select class="form-select form-select-sm" @bind="item.Income">
                                                        <option value="false">Expense</option>
                                                        <option value="true">Income</option>
                                                    </select>
                                                }
                                                else if (item.Income)
                                                {
                                                    <span class="badge bg-success">@Loc["Income"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@Loc["Expense"]</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-muted small" title="@item.ReasonText">@TruncateText(item.ReasonText, 25)</span>
                                            </td>
                                            <td>
                                                @if (item.IsEditing)
                                                {
                                                    <button class="btn btn-sm btn-success me-1" @onclick="() => SaveEdit(item)" title='@Loc["Save"]'>
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-secondary" @onclick="() => CancelEdit(item)" title='@Loc["Cancel"]'>
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => AcceptSingle(item)" disabled="@IsProcessing" title='@Loc["Accept"]'>
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(item)" disabled="@IsProcessing" title='@Loc["Edit"]'>
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectSingle(item)" disabled="@IsProcessing" title='@Loc["Reject"]'>
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Progress -->
                    @if (IsProcessing)
                    {
                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span>@Loc["Processing..."]</span>
                                <span>@ProcessProgress%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar progress-bar-striped progress-bar-animated"
                                     style="width: @ProcessProgress%"></div>
                            </div>
                        </div>
                    }

                    <!-- Result Message -->
                    @if (!string.IsNullOrEmpty(ResultMessage))
                    {
                        <div class="alert @(IsResultError ? "alert-danger" : "alert-success") mt-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span>@ResultMessage</span>
                                @if (!string.IsNullOrEmpty(LastAcceptedHref))
                                {
                                    <a class="alert-link" href="@LastAcceptedHref">
                                        @Loc["View accepted transactions"]
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OnClose" disabled="@IsProcessing">
                        @Loc["Close"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}
