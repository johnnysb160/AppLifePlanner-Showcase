{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Retry": {
    "Attempts": "3",
    "BaseDelaySeconds": "1"
  },
  "Database": {
    "CommandTimeoutSeconds": "30"
  }
}
